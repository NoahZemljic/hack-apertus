{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objects",
    "relations"
  ],
  "properties": {
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "target_pixel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "target_pixel": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "width_mm": {
            "type": "number",
            "minimum": 0
          },
          "graspable": {
            "type": "boolean"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "relation",
          "object",
          "confidence"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "image_left_of",
              "image_right_of",
              "image_up_from",
              "image_down_from",
              "inside"
            ]
          },
          "object": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
